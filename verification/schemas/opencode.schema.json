{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["autoupdate", "formatter", "lsp", "share", "plugin", "provider", "mcp"],
  "properties": {
    "$schema": { "type": "string", "format": "uri" },
    "autoupdate": { "const": false },
    "formatter": { "type": "boolean" },
    "lsp": { "type": "boolean" },
    "share": { "enum": ["manual", "auto", "disabled"] },
    "plugin": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "provider": { "type": "object" },
    "mcp": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          { "$ref": "#/$defs/localMcp" },
          { "$ref": "#/$defs/remoteMcp" }
        ]
      }
    }
  },
  "$defs": {
    "localMcp": {
      "type": "object",
      "required": ["type", "command", "enabled"],
      "properties": {
        "type": { "const": "local" },
        "command": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "enabled": { "type": "boolean" }
      },
      "additionalProperties": true
    },
    "remoteMcp": {
      "type": "object",
      "required": ["type", "url", "enabled"],
      "properties": {
        "type": { "const": "remote" },
        "url": { "type": "string", "format": "uri" },
        "enabled": { "type": "boolean" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
