#!/usr/bin/env bash
set -euo pipefail
: "${DOTFILES_REAL_GIT:?Set the actual Git executable}"
args=()
for argument in "$@"; do
  case "$argument" in
  https://github.com/* | https://*@github.com/*)
    argument="git@github.com:${argument##*github.com/}"
    ;;
  http://* | https://* | git://*)
    echo 'This setup requires SSH for Git transport.' >&2
    exit 1
    ;;
  esac
  args+=("$argument")
done
exec "$DOTFILES_REAL_GIT" "${args[@]}"
