{% if vars.git_name | default(value="") != "" and vars.git_email | default(value="") != "" %}
[user]
  name = {{ vars.git_name | json_encode() }}
  email = {{ vars.git_email | json_encode() }}
{% if vars.git_signing_key | default(value="") != "" %}
  signingKey = {{ vars.git_signing_key | json_encode() }}
[gpg]
  format = ssh
[commit]
  gpgSign = true
[tag]
  gpgSign = true
{% endif %}
{% endif %}
{% for account in vars.git_accounts | default(value="") | split(pat=" ") %}
{% if account != "" %}
{% for directory in vars["git_account_" ~ account ~ "_directories"] | split(pat="\n") %}
{% if directory != "" %}
{% set pattern = directory | trim_end(pat="/") | replace(from="\\", to="\\\\") | replace(from="[", to="\\[") | replace(from="]", to="\\]") | replace(from="*", to="\\*") | replace(from="?", to="\\?") %}
[includeIf {{ ("gitdir:" ~ pattern ~ "/") | json_encode() }}]
  path = {{ ("~/.config/git/account-" ~ account ~ ".gitconfig") | json_encode() }}
{% endif %}
{% endfor %}
{% endif %}
{% endfor %}
