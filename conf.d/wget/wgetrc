# Fail fast enough for interactive use, then retry transient failures.
timeout = 60
tries = 3
wait_retry = 5
retry_connrefused = on
retry_on_host_error = on
retry_on_http_error = 429,500,502,503,504

# Keep recursive downloads bounded to the requested tree.
no_parent = on

# Convenience crawling defaults. Override per command with `-e robots=on` when needed.
robots = off
follow_ftp = on

# Use UTF-8 for local URL argument conversion on Wget builds with IRI support.
local_encoding = UTF-8

# Ask for compressed HTTP responses. Wget 1.25 still documents this as experimental.
compression = auto

# Disguise as Chrome on Windows 11 for sites that block Wget's default user agent.
user_agent = Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/148.0.7778.56 Safari/537.36
