# OpenSSH keeps the first value it finds, so host exceptions precede Host *.
Host github.com gitlab.com
    IdentityAgent none
    IdentitiesOnly yes

Host haos-config
    HostName 192.168.122.90
    Port 2222
    User root
    ProxyJump voidcore

Host *
    IdentityAgent "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
