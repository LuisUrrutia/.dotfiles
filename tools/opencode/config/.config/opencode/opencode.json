{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": true,
  "formatter": true,
  "lsp": true,
  "share": "disabled",
  "experimental": {
    "disable_paste_summary": true
  },
  "plugin": [
    "cc-safety-net",
    "@tarquinen/opencode-dcp@latest",
    "opencode-with-claude"
  ],
  "provider": {
    "anthropic": {
      "options": {
        "baseURL": "http://127.0.0.1:3456",
        "apiKey": "dummy"
      }
    }
  },
  "mcp": {
    "Expo": {
      "type": "remote",
      "url": "https://mcp.expo.dev/mcp",
      "enabled": false
    },
    "Browser MCP": {
      "type": "local",
      "command": ["npx", "-y", "@browsermcp/mcp@latest"],
      "enabled": false
    },
    "Figma Desktop": {
      "type": "remote",
      "url": "http://127.0.0.1:3845/mcp",
      "enabled": false
    },
    "Linear Urrutia": {
      "type": "remote",
      "url": "https://mcp.linear.app/mcp",
      "enabled": false
    },
    "Linear Civinova": {
      "type": "remote",
      "url": "https://mcp.linear.app/mcp",
      "enabled": false
    },
    "Chrome DevTools": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "chrome-devtools-mcp@latest",
        "--user-data-dir",
        "{env:HOME}/.local/state/opencode/chrome-devtools-mcp"
      ],
      "enabled": false
    },
    "Playwright": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@playwright/mcp@latest",
        "--user-data-dir",
        "{env:HOME}/.local/state/opencode/playwright-mcp"
      ],
      "enabled": false
    }
  }
}
